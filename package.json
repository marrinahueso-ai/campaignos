{
  "name": "campaignos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint src",
    "test:campaign-builder-v2": "node --experimental-strip-types --test $(find src/lib/campaign-builder-v2/__tests__ -name '*.test.ts' ! -name 'caption-prompts-revision.test.ts' | sort) && npx tsx --test src/lib/campaign-builder-v2/__tests__/caption-prompts-revision.test.ts",
    "test:communications-calendar": "node --experimental-strip-types --test 'src/lib/communications-calendar/__tests__/*.test.ts'",
    "test:calendar-import": "npx tsx --test 'src/lib/calendar-import/__tests__/*.test.ts'",
    "test:meta-publishing": "node --experimental-strip-types --test 'src/lib/meta-publishing/__tests__/*.test.ts'",
    "test:dev-tools": "node --experimental-strip-types --test 'src/lib/dev-tools/__tests__/*.test.ts'",
    "test:events-phase3": "node --experimental-strip-types --test 'src/lib/events/__tests__/events-phase3.test.ts' 'src/lib/events/__tests__/events-home-layout.test.ts' 'src/lib/events/__tests__/export-events-list-pdf.test.ts' 'src/lib/events-phase3/__tests__/*.test.ts' 'src/lib/event-playbooks/__tests__/notes-tenancy.test.ts' 'src/lib/event-playbooks/__tests__/note-content.test.ts'",
    "test:event-volunteers": "npx tsx --test 'src/lib/event-volunteers/__tests__/*.test.ts'",
    "test:tasks-v2": "npx tsx --test 'src/lib/tasks-v2/__tests__/*.test.ts'",
    "test:team-access": "node --experimental-strip-types --test 'src/lib/auth/__tests__/team-access-phase1.test.ts' 'src/lib/auth/__tests__/role-simulator-access.test.ts' 'src/lib/auth/__tests__/membership-access.test.ts' 'src/lib/auth/__tests__/membership-rls-phase-c.test.ts' 'src/lib/auth/__tests__/active-organization.test.ts' 'src/lib/organization-workspace/__tests__/committee-create-phase1.test.ts' 'src/lib/organization-workspace/__tests__/roster-first.test.ts' 'src/lib/organization-workspace/__tests__/roster-invite-link.test.ts' 'src/lib/organization-workspace/__tests__/roster-backfill.test.ts' && npx tsx --test 'src/lib/access-templates/__tests__/access-templates.test.ts' 'src/lib/access-templates/__tests__/effective-access.test.ts' 'src/components/settings-v2/team-access/__tests__/*.test.ts' 'src/lib/auth/__tests__/storage-rls-phase-c3.test.ts' 'src/lib/auth/__tests__/usernames.test.ts'",
    "test:approvals-scheduling": "node --experimental-strip-types --test 'src/lib/approvals-scheduling/__tests__/*.test.ts'",
    "test:insights": "node --experimental-strip-types --test 'src/lib/insights/__tests__/*.test.ts' 'src/lib/meta/__tests__/insights-*.test.ts'",
    "test:ops-usage": "node --experimental-strip-types --test 'src/lib/ops/__tests__/*.test.ts'",
    "reconcile:ai-usage": "node --env-file=.env.local scripts/reconcile-ai-usage.mjs",
    "import:openai-history": "node --env-file=.env.local scripts/import-openai-usage-history.mjs",
    "test:vendors": "node --experimental-strip-types --test 'src/lib/vendors/__tests__/*.test.ts'",
    "test:campaign-files": "node --experimental-strip-types --test 'src/lib/campaign-files/__tests__/files-ease-ui.test.ts' 'src/lib/campaign-files/__tests__/files-layout.test.ts' 'src/lib/campaign-files/__tests__/org-scope.test.ts' 'src/lib/campaign-files/__tests__/type-groups.test.ts' && npx tsx --test 'src/lib/campaign-files/__tests__/document-category.test.ts'",
    "test:inbox-queue": "node scripts/test-inbox-queue-utils.mjs",
    "test:newsletter": "npx tsx --test 'src/lib/newsletter/__tests__/*.test.ts'",
    "clean": "bash scripts/clean.sh",
    "dev:clean": "npm run clean && npm run dev",
    "verify": "bash scripts/verify.sh",
    "test:webhook": "node scripts/test-meta-webhook.mjs",
    "capture:features": "node scripts/capture-feature-screenshots.mjs",
    "capture:features-videos": "node scripts/capture-feature-videos.mjs",
    "test:hey-ralli": "bash scripts/hey-ralli-test.sh run --project=chromium",
    "test:hey-ralli:ui": "bash scripts/hey-ralli-test.sh ui",
    "test:hey-ralli:firefox": "bash scripts/hey-ralli-test.sh run --project=firefox",
    "test:hey-ralli:webkit": "bash scripts/hey-ralli-test.sh run --project=webkit",
    "test:hey-ralli:cross-browser": "bash scripts/hey-ralli-test.sh run --project=chromium --project=firefox --project=webkit",
    "test:hey-ralli:perf": "bash scripts/hey-ralli-test.sh run --project=chromium tests/hey-ralli/perf/19-page-budget.spec.ts",
    "test:flyer-composer": "npx tsx --test 'src/lib/flyer-composer/__tests__/*.test.ts'",
    "test:load:seed": "node --env-file=.env.staging.local load-tests/k6/scripts/seed-load-test-data.mjs",
    "test:load:mint-sessions": "node --env-file=.env.staging.local load-tests/k6/scripts/mint-sessions.mjs",
    "test:load:smoke": "k6 run load-tests/k6/smoke.js",
    "test:load:20-schools": "k6 run load-tests/k6/twenty-schools.js",
    "test:load:light-peak": "k6 run load-tests/k6/light-peak.js",
    "test:load:launch-spike-warmup": "k6 run load-tests/k6/launch-spike-warmup.js",
    "test:load:launch-spike": "k6 run load-tests/k6/launch-spike.js",
    "test:load:headroom-warmup": "k6 run load-tests/k6/launch-headroom-warmup.js",
    "test:load:headroom": "k6 run load-tests/k6/launch-headroom.js",
    "test:load:cleanup": "node --env-file=.env.staging.local load-tests/k6/scripts/cleanup-test-data.mjs",
    "test:load:seed:100-schools:dry-run": "SEED_PROFILE=100-school-architecture SEED_DRY_RUN=true node --env-file=.env.staging.local load-tests/k6/scripts/seed-architecture-dataset.mjs",
    "test:load:seed:100-schools": "SEED_PROFILE=100-school-architecture node --env-file=.env.staging.local load-tests/k6/scripts/seed-architecture-dataset.mjs",
    "test:load:seed:100-schools:unlock": "SEED_PROFILE=100-school-architecture SEED_FORCE_UNLOCK=true node --env-file=.env.staging.local load-tests/k6/scripts/seed-unlock.mjs",
    "test:load:validate:100-schools": "node --env-file=.env.staging.local load-tests/k6/scripts/validate-architecture-seed.mjs",
    "test:load:cleanup:100-schools": "SEED_PROFILE=100-school-architecture node --env-file=.env.staging.local load-tests/k6/scripts/cleanup-test-data.mjs",
    "test:load:mint-sessions:100-schools": "SEED_PROFILE=100-school-architecture node --env-file=.env.staging.local load-tests/k6/scripts/mint-sessions.mjs",
    "test:load:snapshot:database": "node --env-file=.env.staging.local load-tests/k6/scripts/snapshot-database.mjs",
    "test:load:preflight:100-schools": "node --env-file=.env.staging.local load-tests/k6/scripts/preflight-100-schools.mjs",
    "test:load:data-scale:100school:20vu": "k6 run load-tests/k6/data-scale-100school-20vu.js",
    "test:load:data-scale:100school:50vu": "K6_TRACK_HOLD_SLOW=true k6 run load-tests/k6/data-scale-100school-50vu.js",
    "test:load:data-scale:100school:50vu:warmup": "K6_TRACK_HOLD_SLOW=true k6 run load-tests/k6/data-scale-100school-50vu-warmup.js",
    "test:load:data-scale:100school:75vu": "K6_TRACK_HOLD_SLOW=true k6 run load-tests/k6/data-scale-100school-75vu.js",
    "test:load:data-scale:100school:75vu:warmup": "K6_TRACK_HOLD_SLOW=true k6 run load-tests/k6/data-scale-100school-75vu-warmup.js",
    "test:security": "npx tsx --test 'src/lib/security/__tests__/*.test.ts'",
    "audit:ci": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.19.1",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "isomorphic-dompurify": "^3.19.0",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "motion": "^12.42.2",
    "next": "^15.5.19",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.1",
    "sharp": "^0.34.5",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^15.5.19",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
