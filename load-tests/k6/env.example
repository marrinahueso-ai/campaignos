# Copy to load-tests/k6/.env (gitignored) or export in your shell.
# Never commit real credentials.

# Required for all k6 profiles
BASE_URL=https://your-staging-or-preview.example
TEST_RUN_ID=k6-2026-08-01-a1

# Production override (keep unset / false in normal scripts)
# K6_ALLOW_PRODUCTION=true

# Optional: permit write-path probes (still never calls OpenAI/Meta/Resend)
# K6_ALLOW_WRITES=true

# --- Seed / mint / cleanup (Node scripts) ---
# Prefer: node --env-file=.env.local … which loads repo Supabase keys.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
K6_TEST_PASSWORD=replace-with-strong-shared-test-password
# K6_SCHOOL_COUNT=20
# K6_EMAIL_DOMAIN=loadtest.heyralli.invalid
# K6_CLEANUP_DELETE_USERS=true

# --- Sessions for k6 ---
# After mint-sessions, k6 auto-loads:
#   load-tests/k6/data/sessions.local.json
# Or override:
# K6_SESSIONS_FILE=/absolute/path/to/sessions.local.json

# --- Legacy single-cookie smoke (no seed) ---
# COOKIE=sb-xxxx-auth-token=base64-…
# K6_ORG_ID=00000000-0000-4000-8000-000000000001
# K6_EVENT_IDS=uuid1,uuid2
