# =============================================================================
# Hey Ralli — CONTRACTOR local environment template
# =============================================================================
#
# Copy this file, not anyone else's .env.local:
#   cp .env.contractor.example .env.local
#
# Fill values from the shared 1Password staging item. NEVER paste production
# keys. If a Supabase URL hostname is zyllfqieeihshnwpakiv.supabase.co you are
# on PRODUCTION — stop and ask the founder for staging (heyralli-staging /
# hdoujyngcqrsgtvqehyt) instead.
#
# Leave NEXT_PUBLIC_SITE_URL unset so OAuth stays on http://localhost:3000.
#
# Full name catalog: .env.local.example
# Setup guide: docs/engineering/contractor-onboarding.md
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED for basic local development (STAGING values only)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://hdoujyngcqrsgtvqehyt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Skip the founding-code gate so you can create a throwaway school locally.
# Production must keep this true (or unset). Do not copy production codes.
CAMPAIGNOS_REQUIRE_ACCESS_CODE=false

# -----------------------------------------------------------------------------
# STAGING — give after local app boots (still never production)
# -----------------------------------------------------------------------------
# Team invites and some admin paths. This key bypasses row-level security.
# STAGING service_role only.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional locally. Generate a NEW key for staging; do not reuse production.
# openssl rand -hex 32
# DEVELOPER_AGREEMENT_DOWNLOAD_SECRET=
# FOUNDING_ACCESS_LINK_SECRET=

# Optional locally. Generate a NEW 32-byte key for staging; never copy production.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# OAUTH_TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL integrations (staging / test-mode only). Leave blank until needed.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Stripe — TEST mode keys only (sk_test_ / pk_test_). Never sk_live_.
# STRIPE_SECRET_KEY=sk_test_
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PROFESSIONAL=
# STRIPE_PRICE_PREMIUM=
# STRIPE_PRICE_RESERVE=
# STRIPE_PRICE_RESERVE_STAR=
# STRIPE_PRICE_RESERVE_MAX=

# Playwright (staging test user only — never production passwords)
# HEY_RALLI_BASE_URL=http://localhost:3000
# HEY_RALLI_TEST_EMAIL=
# HEY_RALLI_TEST_PASSWORD=
# HEY_RALLI_TEST_EVENT_ID=

# Meta / Google / Canva / Monday — only when that task is in scope.
# Register localhost redirects on a staging/test app, not production.
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# -----------------------------------------------------------------------------
# NEVER copy these from production. Leave them unset.
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY from project zyllfqieeihshnwpakiv
# STRIPE_SECRET_KEY that starts with sk_live_
# CRON_SECRET
# OPENAI_ADMIN_KEY
# OAUTH_TOKEN_ENCRYPTION_KEY used in production
# CAMPAIGNOS_FOUNDING_ACCESS_CODES / CAMPAIGNOS_BETA_ACCESS_CODE
# HEY_RALLI_OWNER_EMAILS
# HEY_RALLI_PROD_TEST_EMAIL / HEY_RALLI_PROD_TEST_PASSWORD
# ALLOW_PLAINTEXT_OAUTH_TOKENS=true
# NEWSLETTER_PRODUCTION_SEND_ENABLED=true
# NEXT_PUBLIC_SITE_URL=https://heyralli.com
