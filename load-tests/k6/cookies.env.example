# Copy to cookies.env (gitignored) and fill in. Never commit real values.
#
# BASE_URL: staging / preview preferred. Avoid production with real schools.
BASE_URL=https://your-staging-or-preview.example

# Full Cookie header value from a logged-in browser session on that same host.
# Include every sb-* auth cookie (chunked tokens look like sb-<ref>-auth-token.0, .1, …).
# Example (fake):
# COOKIE=sb-xxxx-auth-token=base64-or-json…; sb-xxxx-auth-token.0=…; sb-xxxx-auth-token.1=…
COOKIE=
